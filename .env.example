# Keep review deployments out of search. This is also the default when unset.
SITE_INDEXABLE=false

# Set the verified production HTTPS origin before enabling indexing.
# Leave blank for previews without a confirmed production hostname.
# An origin contains the scheme and host (and optional port), with no subpath,
# query, fragment or credentials. A trailing slash is accepted.
SITE_URL=

# Build-time configuration is read from .env / .env.production or the shell.
# Shell values take precedence. SITE_INDEXABLE=true requires a valid SITE_URL.
# A configured SITE_URL supplies canonical and social URLs even for a noindex
# preview. Only an indexable build generates a sitemap and advertises it in robots.txt.
