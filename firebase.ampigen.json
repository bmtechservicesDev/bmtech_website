{
  "hosting": {
    "target": "ampigen",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "trailingSlash": true,
    "predeploy": ["node scripts/require-ampigen-production.mjs", "npm run build"],
    "redirects": [
      {
        "source": "/documents/bm-tech-services-company-profile.pdf",
        "destination": "/documents/ampigen-company-profile.pdf",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/build-info.json",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      }
    ]
  }
}
